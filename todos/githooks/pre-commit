#!/bin/sh
# pre-commit — keep todos/LIABILITIES.md and the NetSurf patch record
# consistent with the working tree.
#
# (Until 2026-07-30 this hook also ran `todos/queue.js check`; the file-based
# queue was retired for the cc ticket tracker — see CLAUDE.md "Tickets & the
# work queue" — so the liability register and the patch record are what's left
# to guard.)
#
# Install (per clone — core.hooksPath is local, not committed):
#   git config core.hooksPath todos/githooks
# Bypass a single commit (e.g. an unrelated WIP) with: git commit --no-verify
#
# This hook is opt-in per clone, which is why neither check relies on it alone:
# `node tests/run.js --diff` routes todos/ AND every file the register cites to
# the `todos` suite, which runs the register check too.

# Skips silently on repos that haven't adopted the register.
[ -f todos/LIABILITIES.md ] || exit 0

if ! out=$(node todos/liabilities.js check 2>&1); then
  echo "pre-commit: todos/liabilities.js check failed —" >&2
  echo "$out" >&2
  echo "Fix the register (see: node todos/liabilities.js check) or bypass with: git commit --no-verify" >&2
  exit 1
fi

# The NetSurf patch record (todos/0423): a staged edit under vendor/netsurf/
# must keep patches/ consistent with the trees IN THE SAME COMMIT, or the next
# update.sh run silently destroys it (the 0407 shape). patchcheck.mjs proves it
# by inversion — reverse-applying the record on both sides of the change —
# so hunk reframing passes and a missing or wrong hunk cannot hide.
if git diff --cached --name-only | grep -q '^vendor/netsurf/'; then
  if ! out=$(node vendor/netsurf/patchcheck.mjs --staged 2>&1); then
    echo "pre-commit: vendor/netsurf/patchcheck.mjs --staged failed —" >&2
    echo "$out" >&2
    echo "Mirror the tree change into patches/<component>.diff (and patches/pristine.json if the residual moved) or bypass with: git commit --no-verify" >&2
    exit 1
  fi
fi
exit 0
