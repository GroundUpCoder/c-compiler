{
  "deck": 1,
  "size": { "w": 1280, "h": 720 },
  "theme": {
    "background": "#101418",
    "text": { "font": "sans", "size": 32, "color": "#e8e8e8" },
    "stroke": { "color": "#e8e8e8", "width": 3 },
    "fill": "#1d2733"
  },
  "slides": [
    {
      "id": "title",
      "notes": "The seeded demo deck. Slide 1 is also the source of deck-title.png on the made-with slide (deck --shot, self-referential).",
      "elements": [
        { "id": "h1", "type": "text",
          "x": 80, "y": 210, "w": 1120, "h": 150,
          "text": "gucOS",
          "style": { "size": 110, "align": "center", "valign": "middle", "color": "#ffffff" } },
        { "id": "sub", "type": "text",
          "x": 80, "y": 375, "w": 1120, "h": 60,
          "text": "an operating system you can own",
          "style": { "size": 40, "align": "center", "valign": "middle", "color": "#9fb6c9" } },
        { "id": "rule", "type": "line",
          "x1": 400, "y1": 470, "x2": 880, "y2": 470,
          "style": { "stroke": "#7fd4ff", "width": 4, "startArrow": true, "endArrow": true } },
        { "id": "sq1", "type": "rect", "x": 544, "y": 510, "w": 48, "h": 48,
          "style": { "fill": "#7fd4ff", "stroke": "none", "radius": 8 } },
        { "id": "sq2", "type": "rect", "x": 616, "y": 510, "w": 48, "h": 48,
          "style": { "fill": "#ffd27f", "stroke": "none", "radius": 8 } },
        { "id": "sq3", "type": "rect", "x": 688, "y": 510, "w": 48, "h": 48,
          "style": { "fill": "#7fff9e", "stroke": "none", "radius": 8 } },
        { "id": "foot", "type": "text",
          "x": 80, "y": 620, "w": 1120, "h": 40,
          "text": "/bin/deck  -  the gucOS presenter",
          "style": { "size": 24, "align": "center", "valign": "middle", "color": "#6b7a88" } }
      ]
    },
    {
      "id": "arch",
      "notes": "The diagram slide: labeled boxes + arrows + a dashed edge + an ellipse - the shapes the 013 deck needs.",
      "elements": [
        { "id": "h1", "type": "text",
          "x": 80, "y": 40, "w": 1120, "h": 60,
          "text": "How gucOS runs",
          "style": { "size": 44, "color": "#ffffff" } },
        { "id": "box-page", "type": "rect",
          "x": 80, "y": 170, "w": 250, "h": 110,
          "style": { "fill": "#1d2733", "stroke": "#7fd4ff", "strokeWidth": 3, "radius": 12 },
          "label": { "text": "os.html\none browser tab", "size": 28 } },
        { "id": "box-kernel", "type": "rect",
          "x": 520, "y": 170, "w": 250, "h": 110,
          "style": { "fill": "#1d2733", "stroke": "#7fd4ff", "strokeWidth": 3, "radius": 12 },
          "label": { "text": "kernel worker\nkernel.js + compositor", "size": 26 } },
        { "id": "disk", "type": "ellipse",
          "x": 520, "y": 430, "w": 250, "h": 110,
          "style": { "fill": "none", "stroke": "#ffd27f", "strokeWidth": 3 },
          "label": { "text": "BlockFS on OPFS", "size": 26, "color": "#ffd27f" } },
        { "id": "p-sh", "type": "rect",
          "x": 980, "y": 90, "w": 220, "h": 80,
          "style": { "fill": "#16211a", "stroke": "#7fff9e", "strokeWidth": 3, "radius": 12 },
          "label": { "text": "/bin/sh", "size": 28 } },
        { "id": "p-deck", "type": "rect",
          "x": 980, "y": 210, "w": 220, "h": 80,
          "style": { "fill": "#16211a", "stroke": "#7fff9e", "strokeWidth": 3, "radius": 12 },
          "label": { "text": "/bin/deck", "size": 28 } },
        { "id": "p-wm", "type": "rect",
          "x": 980, "y": 330, "w": 220, "h": 80,
          "style": { "fill": "#16211a", "stroke": "#7fff9e", "strokeWidth": 3, "radius": 12 },
          "label": { "text": "/bin/wm", "size": 28 } },
        { "id": "a-page", "type": "line",
          "x1": 330, "y1": 225, "x2": 520, "y2": 225,
          "style": { "endArrow": true } },
        { "id": "a-sh", "type": "line",
          "x1": 770, "y1": 200, "x2": 980, "y2": 135,
          "style": { "endArrow": true } },
        { "id": "a-deck", "type": "line",
          "x1": 770, "y1": 225, "x2": 980, "y2": 248,
          "style": { "endArrow": true } },
        { "id": "a-wm", "type": "line",
          "x1": 770, "y1": 250, "x2": 980, "y2": 362,
          "style": { "endArrow": true } },
        { "id": "a-disk", "type": "line",
          "x1": 645, "y1": 280, "x2": 645, "y2": 430,
          "style": { "stroke": "#ffd27f", "endArrow": true, "dash": [8, 6] } },
        { "id": "cap", "type": "text",
          "x": 80, "y": 600, "w": 1120, "h": 60,
          "text": "every window is a real wasm process - spawned, scheduled and composited by the kernel worker",
          "style": { "size": 26, "align": "center", "valign": "middle", "color": "#9fb6c9" } }
      ]
    },
    {
      "id": "made-with",
      "notes": "deck-title.png is slide 1 of THIS deck, rendered by deck --shot - the tool demonstrating itself.",
      "elements": [
        { "id": "h1", "type": "text",
          "x": 80, "y": 40, "w": 1120, "h": 60,
          "text": "Made with /bin/deck",
          "style": { "size": 44, "color": "#ffffff" } },
        { "id": "feat", "type": "text",
          "x": 80, "y": 150, "w": 600, "h": 320,
          "text": "JSON in, slides out:\n\n-  stable ids + explicit geometry\n-  boxes, ellipses, arrows, images\n-  4x supersampled anti-aliasing\n-  freetype text + word wrap\n-  live reload on every save",
          "style": { "size": 28, "color": "#e8e8e8" } },
        { "id": "shot-frame", "type": "rect",
          "x": 748, "y": 128, "w": 464, "h": 284,
          "style": { "fill": "none", "stroke": "#7fd4ff", "strokeWidth": 3, "radius": 8 } },
        { "id": "shot", "type": "image", "src": "deck-title.png",
          "x": 760, "y": 140, "w": 440, "h": 260, "fit": "contain" },
        { "id": "a-shot", "type": "polyline",
          "points": [[620, 500], [700, 500], [700, 290], [736, 290]],
          "style": { "stroke": "#7fff9e", "endArrow": true } },
        { "id": "shot-cap", "type": "text",
          "x": 748, "y": 424, "w": 464, "h": 32,
          "text": "slide 1 of this deck, rendered by deck --shot",
          "style": { "size": 22, "align": "center", "valign": "middle", "color": "#9fb6c9" } },
        { "id": "foot", "type": "text",
          "x": 80, "y": 620, "w": 1120, "h": 40,
          "text": "Right / Space: next     Left: back     g: last     q: quit     Ctrl-R: reload",
          "style": { "size": 22, "align": "center", "valign": "middle", "color": "#6b7a88" } }
      ]
    },
    {
      "id": "edit-me",
      "notes": "The on-camera moment: edit + save while presenting. A broken save holds the last-good slide under a red banner.",
      "elements": [
        { "id": "h1", "type": "text",
          "x": 80, "y": 40, "w": 1120, "h": 60,
          "text": "Edit me - live",
          "style": { "size": 44, "color": "#ffffff" } },
        { "id": "steps", "type": "text",
          "x": 80, "y": 150, "w": 620, "h": 360,
          "text": "1. Open this .deck file in gcode or vi\n2. Move a box, change a color\n3. Save - the slide reloads instantly\n\nSave broken JSON and nothing is lost: the last-good slide stays up under a red banner that names the error. Fix it, save, keep going.",
          "style": { "size": 30, "color": "#e8e8e8" } },
        { "id": "try-me", "type": "rect",
          "x": 820, "y": 260, "w": 280, "h": 130,
          "style": { "fill": "none", "stroke": "#7fff9e", "strokeWidth": 4, "radius": 16 },
          "label": { "text": "move me", "size": 30, "color": "#7fff9e" } },
        { "id": "a-try", "type": "line",
          "x1": 700, "y1": 420, "x2": 860, "y2": 396,
          "style": { "stroke": "#7fff9e", "endArrow": true, "dash": [6, 5] } },
        { "id": "foot", "type": "text",
          "x": 80, "y": 620, "w": 1120, "h": 40,
          "text": "this file lives in Desktop/Presentations/gucOS - it is yours",
          "style": { "size": 24, "align": "center", "valign": "middle", "color": "#6b7a88" } }
      ]
    }
  ]
}
