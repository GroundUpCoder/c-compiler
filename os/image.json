{
  "version": 12,
  "dirs": [
    "/bin",
    "/etc",
    "/root",
    "/root/roms",
    "/run",
    "/tmp"
  ],
  "files": {
    "/bin/sh": {
      "project": "vendor/busybox/bin.json"
    },
    "/bin/psh": {
      "c": "protoshell.c"
    },
    "/bin/cc": {
      "c": "cc.c"
    },
    "/bin/winbox": {
      "c": "winbox.c"
    },
    "/bin/gpubox": {
      "c": "gpubox.c"
    },
    "/bin/wm": {
      "c": "wm.c",
      "hdrs": ["wm_proto.h"]
    },
    "/bin/wmctl": {
      "c": "wmctl.c",
      "hdrs": ["wm_proto.h"]
    },
    "/root/hello.c": {
      "text": "hello.c"
    },
