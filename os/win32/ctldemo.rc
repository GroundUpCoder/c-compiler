/* ctldemo.rc — the 0104 dialog-keyboard acceptance resource (a sidecar
 * .res pack compiled by tools/win32rc.js, seeded at /usr/bin/ctldemo.res).
 * A tiny "Options" dialog exercises the whole IsDialogMessage keyboard
 * story: Tab/Shift+Tab walk the WS_TABSTOP controls, Alt+mnemonic
 * jumps/presses (the '&'-marked letters), Enter fires the DEFPUSHBUTTON,
 * Esc = IDCANCEL. Change the ids together with os/win32/ctldemo.c. */

#define IDD_OPTIONS   50
#define IDC_OPT_EDIT  120
#define IDC_OPT_CHECK 121
#define IDOK    1
#define IDCANCEL 2

IDD_OPTIONS DIALOGEX 0, 0, 160, 80
CAPTION "Options"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT         "&Name", -1,            8,  8, 40, 10
    EDITTEXT      IDC_OPT_EDIT,          50,  6, 100, 12
    AUTOCHECKBOX  "&Verbose", IDC_OPT_CHECK, 8, 28, 90, 10
    DEFPUSHBUTTON "&OK", IDOK,           30, 56, 50, 14
    PUSHBUTTON    "&Cancel", IDCANCEL,   90, 56, 50, 14
END
