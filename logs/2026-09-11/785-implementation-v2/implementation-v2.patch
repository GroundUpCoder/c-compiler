+  assert.deepStrictEqual(pair(fs.stat('/hard')), p);
+  assert.deepStrictEqual(pair(fs.stat('/across')), q);
+  assert.deepStrictEqual(pair(fs.stat('/other/back')), p);
+  assert.strictEqual(fs.lstat('/across').dev, p[0]);
