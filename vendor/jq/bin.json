{
  "bin": true,
  "name": "jq",
  "description": "jq 1.7.1 — command-line JSON processor",
  "includes": [".", "src", "oniguruma"],
  "compilerArgs": [
    "-DIEEE_8087",
    "-DHAVE_ALLOCA_H",
    "-DHAVE_ISATTY",
    "-DHAVE_STRFTIME",
    "-DHAVE_STRPTIME",
    "-DHAVE_TIMEGM",
    "-DHAVE_GMTIME_R",
    "-DHAVE_LOCALTIME_R",
    "-DHAVE_TM_TM_GMT_OFF",
    "-DHAVE_SETENV",
    "-DHAVE_LIBONIG",
    "-DHAVE_CONFIG_H",
    "-DUSE_DECNUM",
    "-DHAVE_ACOS", "-DHAVE_ACOSH", "-DHAVE_ASIN", "-DHAVE_ASINH", "-DHAVE_ATAN",
    "-DHAVE_ATAN2", "-DHAVE_ATANH", "-DHAVE_CBRT", "-DHAVE_CEIL", "-DHAVE_COPYSIGN",
    "-DHAVE_COS", "-DHAVE_COSH", "-DHAVE_ERF", "-DHAVE_ERFC", "-DHAVE_EXP",
    "-DHAVE_EXP2", "-DHAVE_EXPM1", "-DHAVE_FABS", "-DHAVE_FDIM", "-DHAVE_FLOOR",
    "-DHAVE_FMAX", "-DHAVE_FMIN", "-DHAVE_FMOD", "-DHAVE_FREXP", "-DHAVE_HYPOT",
    "-DHAVE_LDEXP", "-DHAVE_LGAMMA", "-DHAVE_LOG", "-DHAVE_LOG10", "-DHAVE_LOG1P",
    "-DHAVE_LOG2", "-DHAVE_LOGB", "-DHAVE_MODF", "-DHAVE_NEARBYINT", "-DHAVE_NEXTAFTER",
    "-DHAVE_POW", "-DHAVE_RINT", "-DHAVE_ROUND", "-DHAVE_SIN", "-DHAVE_SINH",
    "-DHAVE_SQRT", "-DHAVE_TAN", "-DHAVE_TANH", "-DHAVE_TGAMMA", "-DHAVE_TRUNC"
  ],
  "sources": [
    "src/main.c",
    "oniguruma/onig_init.c",
    "oniguruma/regcomp.c",
    "oniguruma/regenc.c",
    "oniguruma/regerror.c",
    "oniguruma/regexec.c",
    "oniguruma/regext.c",
    "oniguruma/regparse.c",
    "oniguruma/regsyntax.c",
    "oniguruma/regtrav.c",
    "oniguruma/regversion.c",
    "oniguruma/st.c",
    "oniguruma/ascii.c",
    "oniguruma/utf8.c",
    "oniguruma/unicode.c",
    "oniguruma/unicode_unfold_key.c",
    "oniguruma/unicode_fold1_key.c",
    "oniguruma/unicode_fold2_key.c",
    "oniguruma/unicode_fold3_key.c",
    "src/builtin.c",
    "src/bytecode.c",
    "src/compile.c",
    "src/execute.c",
    "src/jq_test.c",
    "src/jv.c",
    "src/jv_alloc.c",
    "src/jv_aux.c",
    "src/jv_dtoa.c",
    "src/jv_dtoa_tsd.c",
    "src/jv_file.c",
    "src/jv_parse.c",
    "src/jv_print.c",
    "src/jv_unicode.c",
    "src/linker.c",
    "src/locfile.c",
    "src/util.c",
    "src/lexer.c",
    "src/parser.c",
    "src/decNumber/decContext.c",
    "src/decNumber/decNumber.c"
  ]
}
