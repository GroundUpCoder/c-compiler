{
  "bin": true,
  "name": "tcc-i386",
  "description": "TCC 0.9.27 i386 cross-compiler — functional port; emits i386 ELF objects byte-identical to a native tcc build (see tests/run.py --types=tcc)",
  "compilerArgs": [
    "-DONE_SOURCE=1",
    "-DTCC_TARGET_I386",
    "-DTCC_WASM_BUILD",
    "-DCONFIG_TCC_PREDEFS=1",
    "-DCONFIG_TCC_CROSSPREFIX=\"i386-\"",
    "-DCONFIG_TCCDIR=\"/tcc\"",
    "-DCONFIG_TCC_SYSINCLUDEPATHS=\"/tcc/include\"",
    "-DCONFIG_TCC_LIBPATHS=\"/tcc/lib\"",
    "-DCONFIG_TRIPLET=\"i386-unknown-elf\"",
    "--allow-undefined"
  ],
  "includes": ["."],
  "sources": ["tcc.c"]
}
