{
  "type": "lib",
  "name": "libgit2",
  "description": "libgit2 — portable Git library (core only, no networking)",
  "includes": [
    "stubs",
    "stubs/sys",
    "stubs/netinet",
    "stubs/arpa",
    "src/util",
    "src/libgit2",
    "include",
    "deps/pcre2",
    "deps/xdiff",
    "deps/reftable",
    "deps/llhttp",
    "deps/ntlmclient",
    "deps/zlib",
    "."
  ],
  "compilerArgs": [
    "-DLIBGIT2_NO_FEATURES_H",
    "-DGIT_WIN32=0",
    "-DNO_MMAP",
    "-DGIT_SHA1_BUILTIN",
    "-DGIT_SHA256_BUILTIN",
    "-DGIT_COMPRESSION_ZLIB",
    "-DGIT_REGEX_PCRE2",
    "-DGIT_HTTPPARSER_LLHTTP",
    "-DGIT_ARCH_64",
    "-DGIT_QSORT_C11",
    "-DGIT_IO_SELECT",
    "-DGIT_AUTH_NTLM_BUILTIN",
    "-DGIT_AUTH_NTLM=1",
    "-DGIT_HTTP=1",
    "-DPCRE2_STATIC",
    "-DPCRE2_CODE_UNIT_WIDTH=8",
    "-DHAVE_LONG_LONG=1",
    "-D_STDINT_H"
  ],
  "sources": [
