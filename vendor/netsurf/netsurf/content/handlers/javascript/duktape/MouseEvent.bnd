/* Binding for browser using duktape and libdom
 *
 * This file is part of NetSurf, http://www.netsurf-browser.org/
 *
 * Released under the terms of the MIT License,
 *         http://www.opensource.org/licenses/mit-license
 *
 * MouseEvent had NO .bnd at all, so every one of its attributes generated a
 * silent no-op stub: `event.clientX` read `undefined` on every mouse event
 * the browser fired.  That is why a draw-where-you-clicked canvas was not
 * possible before this lane.
 *
 * Coordinate contract (see also html/interaction.c's
 * html_fire_mouse_event):
 *
 *   pageX/pageY    document-relative — the coordinate the core is given.
 *   clientX/clientY  viewport-relative: page minus the frontend's scroll
 *                  offset (browser_window_get_scroll).  Spec-correct.
 *   screenX/screenY  the core has NO screen origin — a gui_window's position
 *                  on the desktop is never told to it — so these report the
 *                  viewport-relative coordinate, i.e. screen == client for a
 *                  window at the screen origin.  Deliberate and documented:
 *                  the alternative is `undefined`, and unlike page coords
 *                  this at least stays correct as the document scrolls.
 *
 * pageX/pageY are standard (CSSOM View) but absent from the 2015 uievents.idl
 * snapshot vendored here; they are added to it alongside this file.
 */

getter MouseEvent::screenX ()
%{
	dom_exception exc;
	int32_t x;

	/* client, not screen — see the coordinate contract above */
	exc = dom_mouse_event_get_client_x(priv->parent.parent.evt, &x);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) x);
	return 1;
%}

getter MouseEvent::screenY ()
%{
	dom_exception exc;
	int32_t y;

	exc = dom_mouse_event_get_client_y(priv->parent.parent.evt, &y);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) y);
	return 1;
%}

getter MouseEvent::clientX ()
%{
	dom_exception exc;
	int32_t x;

	exc = dom_mouse_event_get_client_x(priv->parent.parent.evt, &x);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) x);
	return 1;
%}

getter MouseEvent::clientY ()
%{
	dom_exception exc;
	int32_t y;

	exc = dom_mouse_event_get_client_y(priv->parent.parent.evt, &y);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) y);
	return 1;
%}

getter MouseEvent::pageX ()
%{
	dom_exception exc;
	int32_t x;

	/* the document-relative coordinate lives in libdom's screen slot */
	exc = dom_mouse_event_get_screen_x(priv->parent.parent.evt, &x);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) x);
	return 1;
%}

getter MouseEvent::pageY ()
%{
	dom_exception exc;
	int32_t y;

	exc = dom_mouse_event_get_screen_y(priv->parent.parent.evt, &y);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_int(ctx, (duk_int_t) y);
	return 1;
%}

getter MouseEvent::ctrlKey ()
%{
	dom_exception exc;
	bool key;

	exc = dom_mouse_event_get_ctrl_key(priv->parent.parent.evt, &key);
	if (exc != DOM_NO_ERR) return 0;

	duk_push_boolean(ctx, (duk_bool_t) key);
	return 1;
%}

