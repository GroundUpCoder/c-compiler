diff --git a/utils/config.h b/utils/config.h
index 3914771..de398fd 100644
--- a/utils/config.h
+++ b/utils/config.h
@@ -208,4 +208,26 @@ char *realpath(const char *path, char *resolved_path);
 	#define NO_IPV6
 #endif
 
+
+/* gucOS / wasm32 platform section (the _WIN32 lines above are the
+ * precedent).  Flip to the gucOS libc where it provides the extension
+ * (strcasestr, strchrnul) and to upstream's own portable fallbacks for
+ * the rest (scandir, dirfd/unlinkat/fstatat, regex, utsname, mmap).
+ * See vendor/netsurf/README.md for the full patch table. */
+#if defined(__wasm__)
+#include <strings.h>
+#define HAVE_STRCASESTR
+#define HAVE_STRCHRNUL
+#undef HAVE_SCANDIR
+#undef HAVE_DIRFD
+#undef HAVE_UNLINKAT
+#undef HAVE_FSTATAT
+#undef HAVE_REGEX
+#undef HAVE_UTSNAME
+#undef HAVE_MMAP
+#ifndef isascii
+#define isascii(c) (((c) & ~0x7f) == 0)
+#endif
+#endif /* __wasm__ */
+
 #endif
